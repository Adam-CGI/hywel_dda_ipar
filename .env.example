# ============================================================================
# Hywel Dda IPAR Document Miner - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control

# ============================================================================
# Application Settings
# ============================================================================
FLASK_ENV=production
PORT=8000

# ============================================================================
# Azure Resource Configuration
# ============================================================================
RESOURCE_GROUP=rg-hdipar-dev
SUBSCRIPTION_ID=your-subscription-id-here
LOCATION=uksouth

# ============================================================================
# Azure Storage Account
# ============================================================================
AZURE_STORAGE_CONNSTR=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_ACCOUNT=sthdipardev
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_EXTRACTED=extracted
AZURE_STORAGE_CONTAINER_THUMBS=thumbs
AZURE_STORAGE_CONTAINER_MANIFESTS=manifests
AZURE_STORAGE_CONTAINER_ARCHIVE=archive

# ============================================================================
# Azure AI Search
# ============================================================================
AZURE_SEARCH_ENDPOINT=https://ais-hdipar-dev.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key-here
AZURE_SEARCH_INDEX=ipar-chunks

# ============================================================================
# Azure OpenAI Service
# ============================================================================
AZURE_OPENAI_ENDPOINT=https://aoai-hdipar-dev.openai.azure.com/
AZURE_OPENAI_API_KEY=your-openai-api-key-here
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# ============================================================================
# Azure Document Intelligence (Form Recognizer)
# ============================================================================
AZURE_DOCINTEL_ENDPOINT=https://di-hdipar-dev.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=your-document-intelligence-key-here

# ============================================================================
# Azure Cosmos DB
# ============================================================================
COSMOS_ENDPOINT=https://cosmos-hdipar-dev.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key-here
COSMOS_DB=ipar
COSMOS_COLL_DOCUMENTS=documents
COSMOS_COLL_LINEAGE=lineage
COSMOS_COLL_EVENTS=events
COSMOS_COLL_USERS=users

# ============================================================================
# Azure Application Insights (Monitoring)
# ============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# ============================================================================
# Authentication (Microsoft Entra External ID)
# ============================================================================
AUTH_PROVIDER=external-id
EXTERNAL_ID_TENANT=your-tenant-id.ciamlogin.com
EXTERNAL_ID_CLIENT_ID=your-client-id-here
EXTERNAL_ID_ISSUER=https://your-tenant-id.ciamlogin.com/your-tenant-id/v2.0
EXTERNAL_ID_POLICY=B2C_1A_signup_signin
